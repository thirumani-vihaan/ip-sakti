# Copy to .env and fill in. NEVER commit .env.
# The whole app runs with NONE of these set. Each one only upgrades a capability.

# --- Live AI (optional) ---
# Google AI Studio key -> real LLM synthesis + embeddings (else offline fixtures).
GEMINI_API_KEY=
# Bhashini (ULCA) -> full neural HI/TE translation (else offline glossary translator).
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_API_KEY=

# --- Offline semantic embeddings (optional, no key) ---
# Set to 1 AND `pip install sentence-transformers` for local semantic retrieval.
USE_LOCAL_EMBEDDINGS=0

# --- Corpus ---
CORPUS_DIR=./corpus
CORPUS_VERSION=v0

# --- Runtime ---
LOG_LEVEL=INFO
# Per-client request budget per minute (X-Forwarded-For aware behind a proxy).
RATE_LIMIT_PER_MIN=300

# --- Local caches (used by the real/live path) ---
CHROMA_PERSIST_DIR=./data/chroma_db
HF_HOME=./data/hf_cache
SENTENCE_TRANSFORMERS_HOME=./data/hf_cache
